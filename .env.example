# ==============================================================================
# iMenu Frontend Monorepo - Environment Configuration Template
# NOTE: DO NOT commit actual passwords or secrets to version control.
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# API Base URL
API_BASE_URL=http://localhost:3001/api
ADMIN_BASE_URL=http://localhost:3003
MENU_BASE_URL=http://localhost:3005

# Chrome Path (Optional - Puppeteer will auto-detect system Chrome if empty)
CHROME_EXECUTABLE_PATH=

# Demo Account Credentials (Used by E2E test suite scripts)
DEMO_USER_EMAIL=owner@sample.vn
DEMO_USER_PASSWORD=your_demo_password_here

# Client-Side Demo Password Pre-fill (Optional, for rapid local UI testing)
NEXT_PUBLIC_DEMO_PASSWORD=your_demo_password_here
